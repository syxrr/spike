{
  "schema": "bible-strong/avatar-definition",
  "schemaVersion": 1,
  "name": "Strobi",
  "body": {
    "primary": { "type": "sphere", "width": 240, "height": 240, "depth": 240, "roundness": 1 },
    "nodes": []
  },
  "colors": { "body": "#5b8def", "eyes": "#12172b" },
  "expressions": {
    "neutral": {
      "head": { "x": 0, "y": 0, "z": 0 },
      "eyes": {
        "left": { "width": 48, "height": 52, "x": 0, "y": 0, "angle": 0 },
        "right": { "width": 48, "height": 52, "x": 0, "y": 0, "angle": 0 },
        "spacing": 78
      },
      "perspective": 1.4,
      "motion": { "eyes": "microSaccades", "body": "slowDrift" }
    },
    "happy": {
      "head": { "x": 0, "y": 0, "z": 0 },
      "eyes": {
        "left": { "width": 54, "height": 30, "x": 0, "y": -6, "angle": 8 },
        "right": { "width": 54, "height": 30, "x": 0, "y": -6, "angle": -8 },
        "spacing": 82
      },
      "perspective": 1.4,
      "motion": { "eyes": "microSaccades", "body": "slowDrift" }
    },
    "curious": {
      "head": { "x": -6, "y": 18, "z": 4 },
      "eyes": {
        "left": { "width": 44, "height": 58, "x": 4, "y": -4, "angle": 0 },
        "right": { "width": 52, "height": 62, "x": 4, "y": -8, "angle": 0 },
        "spacing": 74
      },
      "perspective": 1.6,
      "motion": { "eyes": "microSaccades", "body": "slowDrift" }
    },
    "surprised": {
      "head": { "x": -10, "y": 0, "z": 0 },
      "eyes": {
        "left": { "width": 62, "height": 70, "x": 0, "y": 0, "angle": 0 },
        "right": { "width": 62, "height": 70, "x": 0, "y": 0, "angle": 0 },
        "spacing": 86
      },
      "perspective": 1.8,
      "motion": { "eyes": "shake", "body": "shake" }
    },
    "asleep": {
      "head": { "x": 14, "y": 0, "z": -8 },
      "eyes": {
        "left": { "width": 50, "height": 5, "x": 0, "y": 6, "angle": 0 },
        "right": { "width": 50, "height": 5, "x": 0, "y": 6, "angle": 0 },
        "spacing": 78
      },
      "perspective": 1.3,
      "motion": { "eyes": "none", "body": "slowDrift" }
    }
  },
  "expressionOrder": ["neutral", "happy", "curious", "surprised", "asleep"],
  "animations": {
    "idle": {
      "playbackMode": "loop",
      "steps": [
        { "expression": "neutral", "holdMs": 2600, "transitionMs": 900, "transition": "smooth" },
        { "expression": "curious", "holdMs": 1400, "transitionMs": 900, "transition": "smooth" }
      ],
      "blink": { "enabled": true, "initialDelayMs": 600, "minIntervalMs": 2200, "maxIntervalMs": 5200, "durationMs": 130 },
      "metadata": { "label": "Idle", "description": "Resting loop with occasional glances." }
    },
    "greeting": {
      "playbackMode": "once",
      "steps": [
        { "expression": "surprised", "holdMs": 420, "transitionMs": 220, "transition": "snappy" },
        { "expression": "happy", "holdMs": 1500, "transitionMs": 420, "transition": "spring" },
        { "expression": "neutral", "holdMs": 300, "transitionMs": 600, "transition": "smooth" }
      ],
      "blink": { "enabled": true, "initialDelayMs": 900, "minIntervalMs": 1800, "maxIntervalMs": 4200, "durationMs": 120 },
      "metadata": { "label": "Greeting", "description": "Plays once, then reports onAnimationEnd." }
    },
    "sleeping": {
      "playbackMode": "pingPong",
      "steps": [
        { "expression": "asleep", "holdMs": 2400, "transitionMs": 1200, "transition": "smooth" },
        { "expression": "neutral", "holdMs": 500, "transitionMs": 1200, "transition": "smooth" }
      ],
      "blink": { "enabled": false, "initialDelayMs": 0, "minIntervalMs": 2000, "maxIntervalMs": 6000, "durationMs": 120 },
      "metadata": { "label": "Sleeping", "description": "Ping-pong drift between asleep and neutral." }
    }
  },
  "animationOrder": ["idle", "greeting", "sleeping"]
}
